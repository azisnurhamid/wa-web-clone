{
  "name": "wa-web-clone",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "wrangler pages dev --port 8788",
    "pages:dev": "npm run build && wrangler pages dev --port 8788",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
    "db:migrate:local": "wrangler d1 migrations apply WA_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply WA_DB --remote"
  },
  "dependencies": {
    "lucide-react": "^0.563.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^5.3.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@types/node": "^22.20.1",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "prettier": "^3.9.6",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "description": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azisnurhamid/wa-web-clone.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/azisnurhamid/wa-web-clone/issues"
  },
  "homepage": "https://github.com/azisnurhamid/wa-web-clone#readme"
}
